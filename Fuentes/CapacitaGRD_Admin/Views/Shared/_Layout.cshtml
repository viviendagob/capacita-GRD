    <script>
        $(document).ready(function () {
            $(".h-menu > li > a").on("click", function (e) {
                var $li = $(this).parent();
                var $subMenu = $li.children("ul.sub-menu");

                if ($subMenu.length) {
                    e.preventDefault();

                    $(".h-menu > li").not($li).removeClass("open active").children("ul.sub-menu").stop(true, true).slideUp(150);

                    $li.toggleClass("open active");
                    $subMenu.stop(true, true).slideToggle(150);
                }
            });

            $(document).on("click", function (e) {
                if (!$(e.target).closest(".h-menu").length) {
                    $(".h-menu > li").removeClass("open active").children("ul.sub-menu").stop(true, true).slideUp(150);
                }
            });
        });
    </script>

    <script>
                function soloLetras(evento){
                    key = evento.keyCode || evento.which;
                    teclado = String.fromCharCode(key).toLocaleLowerCase();
                    letras = " áéíóúabcdefghijklmnñopqrstuvwxyz";
                    especiales = "8-32-37-38-39-46-164";

                    teclado_especial = false;
                    for (var i in especiales) {
                    if (key == especiales[i]) {
                    teclado_especial = true; break;
                    }
                    }
                    if (letras.indexOf(teclado) == -1 && !teclado_especial) {
                    return false;
                    }
                }

                function soloNumeros(evento){
                    key = evento.keyCode || evento.which;
                    teclado = String.fromCharCode(key).toLocaleLowerCase();
                    letras = "+0123456789";
                    especiales = "-32-37-38-39-46-164";

