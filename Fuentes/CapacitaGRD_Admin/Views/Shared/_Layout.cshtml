    <style>
        /* Corrige el calendario del datepicker: el tema oculta .dropdown-menu mediante
           visibility:hidden y solo lo revierte con la clase .open, pero bootstrap-datepicker
           no agrega esa clase, por lo que el calendario nunca se mostraba. */
        .datepicker.datepicker-dropdown {
            visibility: visible;
            opacity: 1;
        }

        /* Barra de progreso delgada para la navegación por AJAX (pjax.js), en vez de la
           pantalla completa roja del loader (esa solo debe verse en la carga inicial real). */
        #pjax-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            width: 0%;
            background: #E8A020;
            z-index: 99999;
            transition: width 0.2s ease-out, opacity 0.3s ease-out;
            opacity: 0;
        }
        #pjax-progress.pjax-loading {
            opacity: 1;
        }
    </style>

</head>


