@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using CapacitaGRD_Admin.DTOs
<section class="content">
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="col-lg-12">
                <div class="card">
                    <div class="header">
                        <h2><strong>Maestros - Usuarios </strong></h2>

                    </div>

                    <div class="body">
                        <div class="row clearfix">
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <b>Búsqueda</b>
                                <div class="form-group">
                                    <input type="text" class="form-control" id="Usuarios-Buscar-Nombre" placeholder="Usuario" autocomplete="off">
                                </div>
                            </div>

                            <div class="col-lg-6 col-md-6 col-sm-6 mt-3">
                                <button type="button" id="Usuarios-Buscar" class="btn btn-raised btn-primary btn-round waves-effect m-l-20">Buscar</button>
                                <button type="button" id="Usuarios-Agregar" class="btn btn-raised btn-default btn-round waves-effect m-l-20">Agregar</button>
                            </div>
                        </div>
                    </div>
                    <br />

                    <div class="body">


                        <div class="tab-content">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover dataTable dtr-inline" style="width: 100%;" id="Usuarios-Tabla">
                                    <thead>
                                        <tr>
                                            <th>Id</th>
                                            <th>Usuario</th>
                                            <th>Estado</th>
                                            <th>&nbsp;</th>
                                            <th>&nbsp;</th>
                                        </tr>
                                    </thead>

                                    <tbody>                                      
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Modal Usuarios -->
<div class="modal fade" id="Modal-Usuarios" aria-hidden="true" data-codigo="">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="title">Datos del usuario</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">

                <div class="form-group row mb-1">
                    <label for="Modal-Usuarios-Id" class="col-sm-2 col-form-label text-right">Id</label>
                    <div class="col-sm-4">
                        <input id="Modal-Usuarios-Id" name="Modal-Usuarios-Id" class="form-control" type="text" value="" disabled="" />
                    </div>
                </div>

                <div class="form-group row mb-1">
                    <label for="Modal-Usuarios-Usuario" class="col-sm-2 col-form-label text-right">Usuario</label>
                    <div class="col-sm-10">
                        <input id="Modal-Usuarios-Usuario" name="Modal-Usuarios-Usuario" class="form-control" type="text" value="" maxlength="100" autocomplete="off" />
                    </div>

                </div>

                <div class="form-group row mb-1">
                    <label for="Modal-Usuarios-Clave" class="col-sm-2 col-form-label text-right">Clave</label>
                    <div class="col-sm-10">
                        <input id="Modal-Usuarios-Clave" name="Modal-Usuarios-Clave" class="form-control" type="password" value="" maxlength="100" autocomplete="off" />
                    </div>
                </div>

                <div class="form-group row mb-1">
                    <div class="col-sm-2">
                    </div>

                    <div class="col-sm-10">
                        <div class="checkbox">
                            <input id="Modal-Usuarios-Estado" type="checkbox">
                            <label for="Modal-Usuarios-Estado">
                                Activo
                            </label>
                        </div>
                    </div> 
                </div>


            </div>

            <div class="modal-footer">
                <div class="row" style="width: 100%">
                    <div class="col-sm-6 text-left">
                        <button id="Usuarios-Cancelar" type="button" class="btn" data-dismiss="modal">
                            Cancelar
                        </button>
                    </div>

                    <div class="col-sm-6 text-right">
                        <button id="Usuarios-Guardar" type="button" class="btn btn-success pull-right">
                            <i class="material-icons">check_circle</i> Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<!-- Fin - Modal  -->

<script src="~/assets/js/usuarios.js?v=@DateTime.UtcNow"></script>
<script>

    Usuarios.Init();

</script>